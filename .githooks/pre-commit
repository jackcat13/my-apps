#!/usr/bin/env bash
# Fast checks on staged changes. Enabled by `just setup` (git config core.hooksPath .githooks).
# Slow checks (tests, coverage, deny) run in `just check` and CI. Skip once with --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

scripts/check-fast.sh --staged

staged=$(git diff --name-only --cached --diff-filter=ACMR)
if [ -n "$staged" ] && command -v typos >/dev/null; then
  # shellcheck disable=SC2086 # file names in this repo have no spaces
  typos --force-exclude $staged
fi
